[
  {
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "height": 30,
    "margin-top": 0,
    "margin-right": 0,
    "margin-left": 0,
    "modules-left": [
      "cpu",
      "memory",
      "temperature"
    ],
    "modules-center": [
      "niri/window"
    ],
    "modules-right": [
      "pulseaudio",
      "network"
    ],
    "cpu": {
      "interval": 5,
      "format": "󰻠 {usage}%",
      "max-length": 10
    },
    "memory": {
      "interval": 10,
      "format": "󰍛 {percentage}%",
      "tooltip": true,
      "tooltip-format": "RAM - {used:0.1f}GiB used"
    },
    "temperature": {
      // "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
      "input-filename": "temp2_input",
      "critical-threshold": 75,
      "format-critical": "󰔏 {temperatureC}°C",
      "format": "󰔏 {temperatureC}°C"
    },
    "niri/window": {
      "format": "{title}",
      "max-length": 80,
      "icon": true,
      "icon-size": 18,
      "separate-outputs": true
    },
    "pulseaudio": {
      "max-volume": 150,
      "scroll-step": 10,
      "format": "{icon} {volume}%",
      "format-icons": [
        "",
        "",
        ""
      ],
      "format-muted": "",
      "on-click": "ghostty -e pulsemixer"
    },
    "network": {
      "format-wifi": "󰖩 {essid}",
      "format-ethernet": "󰈀 {ifname}",
      "format-disconnected": "󰖪 disconnected"
    }
  },
  {
    "layer": "top",
    "position": "bottom",
    "exclusive": true,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "height": 30,
    "margin-bottom": 0,
    "margin-right": 0,
    "margin-left": 0,
    "modules-left": [
      "niri/workspaces"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "tray"
    ],
    "niri/workspaces": {
      "format": "{icon}",
      "show-special": true
    },
    "clock": {
      "format": "{:%Y-%m-%d  %H:%M}"
    },
    "tray": {
      "icon-size": 18,
      "spacing": 6
    }
  }
]